---
/**
 * Barra lateral: navegación + quién está usando el sistema.
 *
 * Los módulos que no corresponden al rol se ocultan desde el navegador
 * (el sitio es estático, así que el menú se arma igual para todos y después
 * se recorta). La barrera REAL está en las reglas de PocketBase: aunque
 * alguien escriba la dirección a mano, el servidor no le devuelve los datos.
 */
import Marca from "./Marca.astro";

const ruta = Astro.url.pathname.replace(/\/$/, "") || "/";
const activo = (base: string) =>
  base === "/" ? ruta === "/" : ruta === base || ruta.startsWith(base + "/");
---

<aside class="sidebar" id="sidebar">
  <div class="brand">
    <Marca tono="claro" />
    <div>
      <div class="name">CAPI<span class="noa">NOA</span></div>
      <span class="tag">IMPLANTE CAPILAR</span>
    </div>
  </div>

  <nav class="nav">
    <span class="lbl">Gestión</span>

    <a href="/" class={activo("/") ? "active" : ""}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect
          x="14"
          y="3"
          width="7"
          height="5"
          rx="1.5"
        /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect
          x="3"
          y="16"
          width="7"
          height="5"
          rx="1.5"
        /></svg
      >
      Panel
    </a>

    <a href="/pacientes/" class={activo("/pacientes") ? "active" : ""}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><circle cx="9" cy="8" r="3.2" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0" /><path
          d="M16 4.2a3.2 3.2 0 0 1 0 7.6M15.5 20a5.5 5.5 0 0 0-1.6-3.9"
        /></svg
      >
      Pacientes
      <span class="count" id="contadorPacientes"></span>
    </a>

    <a href="/agenda/" class={activo("/agenda") ? "active" : ""}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><rect x="3" y="4.5" width="18" height="16" rx="2.5" /><path
          d="M3 9h18M8 2.5v4M16 2.5v4"
        /></svg
      >
      Agenda
    </a>

    <a href="/finanzas/" class={activo("/finanzas") ? "active" : ""} data-solo="clinico">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><path d="M12 2v20M17 6.5c0-2-2.2-3-5-3s-5 1-5 3.2c0 4.8 10 2.8 10 7.4 0 2.3-2.2 3.4-5 3.4s-5-1.2-5-3.2" /></svg
      >
      Finanzas
    </a>

    <span class="lbl">Sistema</span>
    <a href="/configuracion/" class={activo("/configuracion") ? "active" : ""}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><circle cx="12" cy="12" r="3.2" /><path
          d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.56V21a2 2 0 0 1-4 0v-.09A1.7 1.7 0 0 0 8.9 19.3a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1H3a2 2 0 0 1 0-4h.09A1.7 1.7 0 0 0 4.7 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34H9.1a1.7 1.7 0 0 0 1-1.56V3a2 2 0 0 1 4 0v.09a1.7 1.7 0 0 0 1 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V9.1a1.7 1.7 0 0 0 1.56 1H21a2 2 0 0 1 0 4h-.09a1.7 1.7 0 0 0-1.56 1z"
        /></svg
      >
      Configuración
    </a>

    <a href="#" id="botonReportar" role="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
        ><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" /><path
          d="M12 7.5v3.5M12 13.2v.3"
        /></svg
      >
      Reportar un problema
    </a>
  </nav>

  <div class="side-user">
    <div class="av" id="usuarioIniciales">··</div>
    <div class="who">
      <b id="usuarioNombre">—</b>
      <span id="usuarioRol"></span>
    </div>
    <button class="logout" id="botonSalir" title="Cerrar sesión" aria-label="Cerrar sesión">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        ><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 17l-5-5 5-5M5 12h11" /></svg
      >
    </button>
  </div>
</aside>

<script>
  import { usuarioActual, salir, puedeVerClinico, puedeAdministrar, NOMBRE_ROL, sincronizarSesion } from "../lib/auth";
  import { pb } from "../lib/pocketbase";
  import { abrirReporte } from "../lib/reportar";

  // "Reportar un problema": abre el cuadro en la pantalla donde esté.
  document.getElementById("botonReportar")?.addEventListener("click", (e) => {
    e.preventDefault();
    abrirReporte();
  });

  const usuario = usuarioActual();
  if (usuario) {
    document.getElementById("usuarioNombre")!.textContent = usuario.nombre;
    document.getElementById("usuarioRol")!.textContent = NOMBRE_ROL[usuario.rol] ?? usuario.rol;
    document.getElementById("usuarioIniciales")!.textContent = usuario.nombre
      .split(" ")
      .filter((p) => p.length > 2)
      .slice(0, 2)
      .map((p) => p[0])
      .join("")
      .toUpperCase();
  }

  // Recortar el menú según el rol.
  if (!puedeVerClinico()) {
    document.querySelectorAll('[data-solo="clinico"]').forEach((el) => el.remove());
  }
  if (!puedeAdministrar()) {
    document.querySelectorAll('[data-solo="admin"]').forEach((el) => el.remove());
  }

  document.getElementById("botonSalir")?.addEventListener("click", () => salir());

  // Contador de pacientes al lado del módulo.
  pb.collection("pacientes")
    .getList(1, 1, { fields: "id" })
    .then((r) => {
      const chip = document.getElementById("contadorPacientes");
      if (chip && r.totalItems > 0) chip.textContent = String(r.totalItems);
    })
    .catch(() => {});

  // Refrescar el usuario contra el servidor (por si le cambiaron el rol).
  sincronizarSesion();
</script>
