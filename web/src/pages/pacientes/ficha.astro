      <div class="toolbar acciones">
        <button class="btn btn-primary" id="guardarEval">${ICONO.guardar} Guardar evaluación</button>
      </div>`;

    const caja = document.getElementById("formEvaluacion")!;
    caja.innerHTML = SECCIONES_EVALUACION.map((s) =>
      dibujarSeccion(s, datos, { abierta: false })
    ).join("");
    activarFormulario(caja, () => actualizarProgresos(caja, SECCIONES_EVALUACION));

    document.getElementById("volverLista")?.addEventListener("click", cargarEvaluaciones);

    document.getElementById("borrarEval")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar esta evaluación? No se puede deshacer.")) return;
      try {
        await pb.collection("evaluaciones").delete(ev.id);
        aviso("Evaluación eliminada.");
        cargarEvaluaciones();
        cargarUltimaEvaluacion();
      } catch (e) {
        aviso(mensajeDeError(e), "error");
      }
