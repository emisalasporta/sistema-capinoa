    document.getElementById("guardarEval")?.addEventListener("click", async () => {
      const boton = document.getElementById("guardarEval") as HTMLButtonElement;
      boton.disabled = true;
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value ?? "";
      const uf = val("evUF");
      const cuerpo: Record<string, unknown> = {
