    editor.innerHTML = `
      <div class="toolbar">
        <button class="btn btn-ghost btn-sm" id="volverLista">${ICONO.volver} Volver al listado</button>
        <div class="section-title">${ev ? "Editar evaluación" : "Nueva evaluación"}</div>
        ${ev ? `<button class="btn btn-danger btn-sm empuja" id="borrarEval">${ICONO.borrar} Eliminar</button>` : ""}
      </div>

      <div class="card pad">
        <div class="form-grid">
          <div class="field">
            <label for="evFecha">Fecha <span class="req">*</span></label>
            <input type="date" id="evFecha" value="${esc(fechaInput(ev?.fecha) || hoyInput())}">
          </div>
          <div class="field">
            <label for="evTipo">Tipo <span class="req">*</span></label>
            <select id="evTipo">
              ${Object.entries(TIPOS_EVALUACION)
                .map(([k, v]) => `<option value="${esc(k)}"${ev?.tipo === k ? " selected" : ""}>${esc(v)}</option>`)
                .join("")}
            </select>
          </div>
          <div class="field">
            <label for="evDx">Diagnóstico principal</label>
            <input type="text" id="evDx" value="${esc(ev?.diagnostico_principal ?? "")}">
          </div>
          <div class="field">
            <label for="evNorwood">Norwood-Hamilton</label>
            <select id="evNorwood">${opciones(["I","II","III","III vertex","IV","V","VI","VII"], ev?.norwood)}</select>
          </div>
          <div class="field">
            <label for="evLudwig">Ludwig</label>
            <select id="evLudwig">${opciones(["I","II","III"], ev?.ludwig)}</select>
          </div>
          <div class="field">
            <label for="evSinclair">Sinclair</label>
            <select id="evSinclair">${opciones(["1","2","3","4","5"], ev?.sinclair)}</select>
          </div>
          <div class="field">
            <label for="evCandidato">¿Candidato a FUE?</label>
            <select id="evCandidato">${opciones(["si","no","pendiente","requiere_tratamiento_previo"], ev?.candidato_fue)}</select>
          </div>
          <div class="field">
            <label for="evUF">Unidades foliculares estimadas</label>
            <input type="number" id="evUF" min="0" step="50" value="${esc(ev?.uf_estimadas ?? "")}">
            <div class="ayuda">Es una estimación de trabajo, nunca un resultado prometido.</div>
          </div>
          <div class="field">
            <label for="evProximo">Próximo control</label>
            <input type="date" id="evProximo" value="${esc(fechaInput(ev?.proximo_control))}">
          </div>
        </div>
