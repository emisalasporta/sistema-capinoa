  /* ══════════════════ Fotos ══════════════════ */

  function llenarSelectoresDeFoto() {
    const selMomento = document.getElementById("momentoSubida") as HTMLSelectElement;
    const selToma = document.getElementById("tomaSubida") as HTMLSelectElement;
    if (!selMomento || !selToma) return;
    selMomento.innerHTML = ORDEN_MOMENTOS.map(
      (k) => `<option value="${esc(k)}">${esc(MOMENTOS[k])}</option>`
    ).join("");
    selToma.innerHTML = Object.entries(TOMAS)
      .map(([k, v]) => `<option value="${esc(k)}">${esc(v)}</option>`)
      .join("");
    (document.getElementById("fechaSubida") as HTMLInputElement).value = hoyInput();
  }

  async function traerFotos() {
    try {
      fotos = await pb.collection("fotos").getFullList({
        filter: pb.filter("paciente = {:p}", { p: idPaciente }),
        sort: "-fecha,-created",
      });
    } catch {
      fotos = [];
    }
    return fotos;
  }

  async function cargarGaleria() {
    const caja = document.getElementById("galeria");
    if (!caja) return;
    caja.innerHTML = `<div class="vacio">Cargando fotos…</div>`;
    await traerFotos();

    if (!fotos.length) {
      caja.innerHTML = `<div class="vacio"><b>Todavía no hay fotos</b>Subí las tomas de la consulta inicial para tener el punto de partida.</div>`;
      return;
    }

    // Agrupadas por momento del tratamiento, en orden cronológico.
    const grupos = new Map<string, any[]>();
    for (const f of fotos) {
      const k = f.momento || "otro";
      if (!grupos.has(k)) grupos.set(k, []);
      grupos.get(k)!.push(f);
    }
    const ordenados = [...grupos.entries()].sort(
      (a, b) => ORDEN_MOMENTOS.indexOf(a[0]) - ORDEN_MOMENTOS.indexOf(b[0])
    );

    caja.innerHTML = ordenados
      .map(
        ([momento, lista]) => `
      <div class="grupo-fotos">
        <div class="section-title">
          ${esc(MOMENTOS[momento] ?? legible(momento))}
          <span class="hint">${lista.length} foto${lista.length === 1 ? "" : "s"}</span>
        </div>
        <div class="evo-grid">
          ${lista
            .map(
              (f) => `
            <div class="evo" data-foto="${esc(f.id)}">
              <div class="ph">
                <span class="badge">${esc(TOMAS[f.toma] ?? "Foto")}</span>
                <img data-mini="${esc(f.id)}" alt="Foto ${esc(TOMAS[f.toma] ?? "")}">
              </div>
              <div class="cap"><b>${esc(TOMAS[f.toma] ?? "—")}</b><span>${fecha(f.fecha) || fecha(f.created)}</span></div>
            </div>`
            )
            .join("")}
        </div>
      </div>`
      )
      .join("");

    // Las miniaturas se bajan con permiso; por eso no van en el src directo.
    for (const f of fotos) {
      const img = caja.querySelector<HTMLImageElement>(`[data-mini="${CSS.escape(f.id)}"]`);
      if (!img) continue;
      imagen(f, "archivo", { thumb: "320x240" })
        .then((url) => { img.src = url; })
        .catch(() => { img.alt = "No se pudo cargar"; });
    }

    caja.querySelectorAll<HTMLElement>("[data-foto]").forEach((tarjeta) => {
      tarjeta.addEventListener("click", () => abrirDetalleFoto(tarjeta.dataset.foto!));
    });
  }

  async function subirFotos(archivos: FileList | File[]) {
    const lista = [...archivos].filter((a) => a.type.startsWith("image/"));
    if (!lista.length) return;

    const momento = (document.getElementById("momentoSubida") as HTMLSelectElement).value;
    const toma = (document.getElementById("tomaSubida") as HTMLSelectElement).value;
    const fechaFoto = (document.getElementById("fechaSubida") as HTMLInputElement).value;
    const progreso = document.getElementById("progresoSubida")!;

    let hechas = 0;
    for (const [indice, archivo] of lista.entries()) {
      progreso.textContent = `Subiendo ${hechas + 1} de ${lista.length}…`;
      try {
        const liviana = await achicarFoto(archivo);

        // Se renombra a algo corto y descriptivo. Las fotos que llegan por
        // WhatsApp traen nombres larguísimos ("whats_app_image_2026_08_18_at
        // _12_05_...jpeg"); sumados a la carpeta de miniaturas, la ruta pasa
        // el límite de 260 caracteres de Windows y después falla la copia de
        // seguridad. Con este nombre el archivo además se entiende solo.
        const extension = liviana.type === "image/png" ? "png" : "jpg";
        const nombreCorto = `${toma}-${fechaFoto || hoyInput()}-${indice + 1}.${extension}`;
        const paraSubir = new File([liviana], nombreCorto, { type: liviana.type });

        const cuerpo = new FormData();
        cuerpo.append("paciente", idPaciente!);
        cuerpo.append("archivo", paraSubir);
        cuerpo.append("toma", toma);
        cuerpo.append("momento", momento);
        if (fechaFoto) cuerpo.append("fecha", fechaFoto);
        // Solo se manda si hay usuario: PocketBase rechaza un texto vacío en un
        // campo de relación.
        const quien = usuarioActual()?.id;
        if (quien) cuerpo.append("subido_por", quien);
        await pb.collection("fotos").create(cuerpo);
        hechas++;
      } catch (e) {
        aviso(`No se pudo subir ${archivo.name}: ${mensajeDeError(e)}`, "error");
      }
    }
    progreso.textContent = "";
    if (hechas) {
      aviso(`${hechas} foto${hechas === 1 ? "" : "s"} guardada${hechas === 1 ? "" : "s"}.`);
      cargarGaleria();
    }
  }

  function conectarSubidaDeFotos() {
    const zona = document.getElementById("zonaFotos");
    const input = document.getElementById("archivoFotos") as HTMLInputElement;
    if (!zona || !input) return;

    // El <input file> está DENTRO de la zona. Si no cortamos acá la propagación,
    // el clic que hacemos sobre el input vuelve a subir hasta la zona, la zona
    // vuelve a pedir el input… y el diálogo de archivos se abre dos veces.
    input.addEventListener("click", (e) => e.stopPropagation());

    zona.addEventListener("click", () => input.click());
    zona.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter" || (e as KeyboardEvent).key === " ") {
        e.preventDefault();
        input.click();
      }
    });
    input.addEventListener("change", () => {
      if (input.files?.length) subirFotos(input.files);
      input.value = "";
    });

    ["dragenter", "dragover"].forEach((ev) =>
      zona.addEventListener(ev, (e) => {
        e.preventDefault();
        zona.classList.add("drag");
      })
    );
    ["dragleave", "drop"].forEach((ev) =>
      zona.addEventListener(ev, (e) => {
        e.preventDefault();
        zona.classList.remove("drag");
      })
    );
    zona.addEventListener("drop", (e) => {
      const dt = (e as DragEvent).dataTransfer;
      if (dt?.files?.length) subirFotos(dt.files);
    });
  }

  /** Vista grande de una foto, con opción de reclasificarla, marcarla o borrarla. */
  async function abrirDetalleFoto(idFoto: string) {
    const f = fotos.find((x) => x.id === idFoto);
    if (!f) return;

    const dlg = document.createElement("dialog");
    dlg.className = "modal";
    dlg.innerHTML = `
      <div class="modal-head">
        <h3>${esc(TOMAS[f.toma] ?? "Foto")} · ${esc(MOMENTOS[f.momento] ?? "")}</h3>
        <button class="modal-cerrar" aria-label="Cerrar">&times;</button>
      </div>
      <div class="modal-body">
        <img id="fotoGrande" style="width:100%; border-radius:12px; display:block; background:var(--card-2)" alt="">
        <div class="form-grid" style="margin-top:var(--esp-3)">
          <div class="field">
            <label>Toma</label>
            <select id="editToma">${Object.entries(TOMAS).map(([k, v]) => `<option value="${esc(k)}"${f.toma === k ? " selected" : ""}>${esc(v)}</option>`).join("")}</select>
          </div>
          <div class="field">
            <label>Momento</label>
            <select id="editMomento">${ORDEN_MOMENTOS.map((k) => `<option value="${esc(k)}"${f.momento === k ? " selected" : ""}>${esc(MOMENTOS[k])}</option>`).join("")}</select>
          </div>
          <div class="field">
            <label>Fecha</label>
            <input type="date" id="editFecha" value="${esc(fechaInput(f.fecha))}">
          </div>
          <div class="field completo">
            <label>Notas</label>
            <input type="text" id="editNotas" value="${esc(f.notas ?? "")}">
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-danger btn-sm" id="borrarFoto">${ICONO.borrar} Eliminar</button>
        <button class="btn btn-ghost btn-sm" id="irAMarcar">${ICONO.lapiz} Marcar sobre esta foto</button>
        <button class="btn btn-primary btn-sm" id="guardarFoto">${ICONO.guardar} Guardar</button>
      </div>`;
    document.body.appendChild(dlg);
    dlg.showModal();

    let urlGrande = "";
    imagen(f, "archivo", { thumb: "800x600" })
      .then((url) => {
        urlGrande = url;
        (dlg.querySelector("#fotoGrande") as HTMLImageElement).src = url;
      })
      .catch(() => {});

    const cerrar = () => {
      liberar(urlGrande);
      dlg.close();
      dlg.remove();
    };
    dlg.querySelector(".modal-cerrar")?.addEventListener("click", cerrar);
    dlg.addEventListener("close", () => liberar(urlGrande));

    dlg.querySelector("#guardarFoto")?.addEventListener("click", async () => {
      try {
        await pb.collection("fotos").update(f.id, {
          toma: (dlg.querySelector("#editToma") as HTMLSelectElement).value,
          momento: (dlg.querySelector("#editMomento") as HTMLSelectElement).value,
          fecha: (dlg.querySelector("#editFecha") as HTMLInputElement).value,
          notas: (dlg.querySelector("#editNotas") as HTMLInputElement).value,
        });
        aviso("Foto actualizada.");
        cerrar();
        cargarGaleria();
      } catch (e) {
        aviso(mensajeDeError(e), "error");
      }
    });

    dlg.querySelector("#borrarFoto")?.addEventListener("click", async () => {
      if (!confirm("¿Eliminar esta foto? También se borran los marcados hechos sobre ella.")) return;
      try {
        await pb.collection("fotos").delete(f.id);
        aviso("Foto eliminada.");
        cerrar();
        cargarGaleria();
      } catch (e) {
        aviso(mensajeDeError(e), "error");
      }
    });

    dlg.querySelector("#irAMarcar")?.addEventListener("click", async () => {
      cerrar();
      // Se espera a que la tira de fotos esté lista antes de abrir el lienzo:
      // con un temporizador a ojo, en una ficha con muchas fotos a veces
      // llegaba antes de tiempo y no abría nada.
      mostrarPestañaSinCargar("marcado");
      await cargarTiraFotos();
      await abrirMarcador(f.id);
    });
  }

  /* ══════════════════ Marcado sobre la foto ══════════════════ */

  let marcador: Marcador | null = null;
  let urlFotoMarcada = "";
  let marcadoAbierto: any = null;

  async function cargarTiraFotos() {
    const tira = document.getElementById("tiraFotos");
    if (!tira) return;
    await traerFotos();

    if (!fotos.length) {
      tira.innerHTML = `<div class="vacio"><b>Primero hay que subir una foto</b>Andá a la pestaña “Fotos”, subí la foto del paciente y volvé acá para marcarla.</div>`;
      document.getElementById("areaMarcado")!.innerHTML = "";
      return;
    }

    tira.innerHTML = `
      <div class="section-title">Elegí la foto <span class="hint">${fotos.length} disponibles</span></div>
      <div class="evo-grid">
        ${fotos
          .map(
            (f) => `
          <div class="evo" data-elegir="${esc(f.id)}">
            <div class="ph">
              <span class="badge">${esc(TOMAS[f.toma] ?? "Foto")}</span>
              <img data-tira="${esc(f.id)}" alt="">
            </div>
            <div class="cap"><b>${esc(MOMENTOS[f.momento] ?? "—")}</b><span>${fecha(f.fecha) || fecha(f.created)}</span></div>
          </div>`
          )
          .join("")}
      </div>`;

    for (const f of fotos) {
      const img = tira.querySelector<HTMLImageElement>(`[data-tira="${CSS.escape(f.id)}"]`);
      if (img) imagen(f, "archivo", { thumb: "320x240" }).then((u) => { img.src = u; }).catch(() => {});
    }

    tira.querySelectorAll<HTMLElement>("[data-elegir]").forEach((el) => {
      el.addEventListener("click", () => abrirMarcador(el.dataset.elegir!));
    });
  }

  async function abrirMarcador(idFoto: string) {
    const f = fotos.find((x) => x.id === idFoto);
    if (!f) return;

    const area = document.getElementById("areaMarcado")!;
    area.innerHTML = `<div class="vacio">Cargando la foto…</div>`;

    // Marcados que ya existen sobre esta foto.
    let previos: any[] = [];
    try {
      previos = await pb.collection("marcados").getFullList({
        filter: pb.filter("foto = {:f}", { f: idFoto }),
        sort: "-created",
      });
    } catch { /* sin marcados */ }

    area.innerHTML = `
      <div class="marker">
        <div class="canvas-shell" id="shellMarcado">
          <img class="foto" id="fotoMarcado" alt="Foto del paciente">
          <canvas></canvas>
        </div>
        <div class="tools">
          <div class="tool-block">
            <h4>Color</h4>
            <div class="swatches" id="paleta">
              ${COLORES_MARCADO.map(
                (c, i) =>
                  `<button type="button" class="sw${i === 0 ? " active" : ""}" style="background:${c.color}" data-color="${c.color}" title="${esc(c.nombre)}" aria-label="${esc(c.nombre)}"></button>`
              ).join("")}
            </div>
            <div class="sw-leyenda" id="leyendaColor">${esc(COLORES_MARCADO[0].nombre)}</div>
          </div>
          <div class="tool-block">
            <h4>Trazo</h4>
            <div class="sizes" id="grosores">
              <button type="button" class="sz" data-grosor="3"><i style="width:6px;height:6px"></i></button>
              <button type="button" class="sz active" data-grosor="6"><i style="width:12px;height:12px"></i></button>
              <button type="button" class="sz" data-grosor="12"><i style="width:18px;height:18px"></i></button>
            </div>
          </div>
          <div class="tool-block tool-actions">
            <button class="btn btn-ghost btn-sm" id="verSinDibujo">${ICONO.ojo} Ver foto limpia</button>
            <button class="btn btn-ghost btn-sm" id="deshacer">${ICONO.deshacer} Deshacer</button>
            <button class="btn btn-ghost btn-sm" id="limpiar">${ICONO.borrar} Limpiar todo</button>
            <button class="btn btn-primary btn-sm" id="guardarMarcado">${ICONO.guardar} Guardar en la ficha</button>
          </div>
        </div>
      </div>

      <div id="marcadosPrevios"></div>`;

    // La foto se baja con permiso y se usa como imagen local: si no, el navegador
    // no deja exportar el PNG del marcado.
    liberar(urlFotoMarcada);
    try {
      urlFotoMarcada = await imagen(f, "archivo");
    } catch (e) {
      area.innerHTML = `<div class="vacio">No se pudo cargar la foto.</div>`;
      return;
    }

    const img = document.getElementById("fotoMarcado") as HTMLImageElement;
    await new Promise<void>((listo) => {
      img.onload = () => listo();
      img.onerror = () => listo();
      img.src = urlFotoMarcada;
    });

    marcador?.destruir();
    marcador = new Marcador(document.getElementById("shellMarcado")!);
    marcadoAbierto = null;

    // Si ya había un marcado, se abre el más reciente para poder seguir editándolo.
    if (previos.length) {
      marcadoAbierto = previos[0];
      marcador.cargar(previos[0].trazos);
    }

    dibujarPrevios(previos);

    // --- Herramientas ---
    document.querySelectorAll<HTMLElement>("#paleta .sw").forEach((b) => {
      b.addEventListener("click", () => {
        document.querySelectorAll("#paleta .sw").forEach((x) => x.classList.remove("active"));
        b.classList.add("active");
        marcador!.color = b.dataset.color!;
        const nombre = COLORES_MARCADO.find((c) => c.color === b.dataset.color)?.nombre ?? "";
        document.getElementById("leyendaColor")!.textContent = nombre;
      });
    });
    document.querySelectorAll<HTMLElement>("#grosores .sz").forEach((b) => {
      b.addEventListener("click", () => {
        document.querySelectorAll("#grosores .sz").forEach((x) => x.classList.remove("active"));
        b.classList.add("active");
        marcador!.grosor = Number(b.dataset.grosor);
      });
    });
    document.getElementById("deshacer")?.addEventListener("click", () => marcador!.deshacer());
    document.getElementById("limpiar")?.addEventListener("click", () => {
      if (marcador!.vacio || confirm("¿Borrar todo el dibujo de esta foto?")) marcador!.limpiar();
    });

    const ojo = document.getElementById("verSinDibujo")!;
    let visible = true;
    ojo.addEventListener("click", () => {
      visible = !visible;
      marcador!.mostrarDibujo(visible);
      ojo.innerHTML = visible
        ? `${ICONO.ojo} Ver foto limpia`
        : `${ICONO.ojo} Ver con el dibujo`;
    });

    document.getElementById("guardarMarcado")?.addEventListener("click", () => guardarMarcado(f));
  }

  async function guardarMarcado(f: any) {
    const boton = document.getElementById("guardarMarcado") as HTMLButtonElement;
    if (!marcador || marcador.vacio) {
      aviso("Todavía no hay nada dibujado sobre la foto.", "error");
      return;
    }
    boton.disabled = true;
    try {
      // Se guardan las dos cosas: los trazos (para poder seguir editando más
      // adelante) y una imagen combinada lista para mostrar o imprimir.
      const png = await marcador.exportarPNG();
      const cuerpo = new FormData();
      cuerpo.append("foto", f.id);
      cuerpo.append("paciente", idPaciente!);
      cuerpo.append("titulo", `${TOMAS[f.toma] ?? "Foto"} · ${fecha(new Date().toISOString())}`);
      cuerpo.append("trazos", JSON.stringify(marcador.trazos));
      cuerpo.append("fecha", hoyInput());
      const quien = usuarioActual()?.id;
      if (quien) cuerpo.append("creado_por", quien);
      cuerpo.append("render", new File([png], `marcado-${f.id}.png`, { type: "image/png" }));

      marcadoAbierto = marcadoAbierto
        ? await pb.collection("marcados").update(marcadoAbierto.id, cuerpo)
        : await pb.collection("marcados").create(cuerpo);

      aviso("Marcado guardado en la ficha.");
      const previos = await pb.collection("marcados").getFullList({
        filter: pb.filter("foto = {:f}", { f: f.id }),
        sort: "-created",
      });
      dibujarPrevios(previos);
    } catch (e) {
      aviso(mensajeDeError(e), "error");
    }
    boton.disabled = false;
  }

  function dibujarPrevios(previos: any[]) {
    const caja = document.getElementById("marcadosPrevios");
    if (!caja) return;
    if (!previos.length) {
      caja.innerHTML = `<p style="color:var(--muted); font-size:.84rem">Todavía no hay marcados guardados sobre esta foto.</p>`;
      return;
    }
    caja.innerHTML = `
      <div class="section-title">
        Marcados guardados de esta foto
        <span class="hint">se pueden volver a abrir y corregir</span>
      </div>
      <div class="evo-grid">
        ${previos
          .map(
            (m) => `
          <div class="evo" data-marcado="${esc(m.id)}">
            <div class="ph">
              <span class="badge marcado">Marcado</span>
              <img data-render="${esc(m.id)}" alt="">
            </div>
            <div class="cap"><b>${esc(m.titulo || "Marcado")}</b><span>${fecha(m.created)}</span></div>
          </div>`
          )
          .join("")}
      </div>
      <p style="color:var(--muted); font-size:.8rem; margin-top:10px">
        Al abrir uno, el dibujo vuelve al lienzo y “Guardar” actualiza ese mismo
        marcado. Para dejar una propuesta nueva sin pisar la anterior, primero
        tocá “Nuevo marcado”.
      </p>
      <button class="btn btn-ghost btn-sm" id="nuevoMarcado" style="margin-top:8px">${ICONO.mas} Nuevo marcado en blanco</button>`;

    for (const m of previos) {
      const img = caja.querySelector<HTMLImageElement>(`[data-render="${CSS.escape(m.id)}"]`);
      if (img && m.render) {
        imagen(m, "render", { thumb: "320x240" }).then((u) => { img.src = u; }).catch(() => {});
      }
    }

    caja.querySelectorAll<HTMLElement>("[data-marcado]").forEach((el) => {
      el.addEventListener("click", () => {
        const m = previos.find((x) => x.id === el.dataset.marcado);
        if (!m || !marcador) return;
        marcadoAbierto = m;
        marcador.cargar(m.trazos);
        aviso("Marcado abierto. Podés seguir dibujando y guardar.");
        document.getElementById("shellMarcado")?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    document.getElementById("nuevoMarcado")?.addEventListener("click", () => {
      marcadoAbierto = null;
      marcador?.limpiar();
      aviso("Lienzo en blanco. Lo que dibujes se guarda como un marcado nuevo.");
    });
  }

  /* ══════════════════ Arranque ══════════════════ */

  if (clinico) {
    llenarSelectoresDeFoto();
    conectarSubidaDeFotos();
  }
  cargarPaciente();
</script>
