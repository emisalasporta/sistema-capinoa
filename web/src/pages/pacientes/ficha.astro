---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout titulo="Ficha del paciente">
  <a class="btn btn-ghost btn-sm volver" href="/pacientes/">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      ><path d="M15 18l-6-6 6-6" /></svg
    >
    Volver a pacientes
  </a>

  <section class="card pad">
    <div class="pf-head">
      <div class="av" id="pfAvatar">··</div>
      <div>
        <h2 id="pfNombre">Cargando…</h2>
        <div class="pf-meta" id="pfMeta"></div>
      </div>
      <div class="pf-actions">
        <a class="btn btn-ghost btn-sm" id="botonTurno" href="#">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
            ><rect x="3" y="4.5" width="18" height="16" rx="2.5" /><path
              d="M3 9h18M8 2.5v4M16 2.5v4"
            /></svg
          >
          Dar turno
        </a>
        <a class="btn btn-ghost btn-sm" id="botonEditar" href="#">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
            ><path d="M4 20h4l10-10-4-4L4 16z" /><path d="M13.5 6.5l4 4" /></svg
          >
          Editar datos
        </a>
        <button class="btn btn-ghost btn-sm hidden" id="botonEliminar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
            ><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" /></svg
          >
          Eliminar paciente
        </button>
      </div>
    </div>

    <div class="tabs" id="pestanas">
      <button class="active" data-tab="resumen">Resumen</button>
      <button data-tab="historia" data-solo="clinico">Historia clínica</button>
      <button data-tab="evaluaciones" data-solo="clinico">Evaluaciones</button>
      <button data-tab="fotos" data-solo="clinico">Fotos</button>
      <button data-tab="marcado" data-solo="clinico">Marcado sobre foto</button>
      <button data-tab="cuenta" data-solo="clinico">Cuenta</button>
    </div>

    <!-- ══════════ RESUMEN ══════════ -->
    <div class="tabpane" data-pane="resumen">
      <div id="cajaAlertas"></div>
      <div class="section-title">Datos personales</div>
      <div class="dl" id="dlPersonales"></div>
      <div data-solo="clinico">
        <div class="section-title">Última evaluación</div>
        <div id="cajaUltimaEval"></div>
      </div>
    </div>

    <!-- ══════════ HISTORIA CLÍNICA ══════════ -->
    <div class="tabpane hidden" data-pane="historia">
      <div class="section-title">
        Historia clínica tricológica
        <span class="hint" id="progresoTotal"></span>
      </div>
      <p class="section-desc">
        Estas preguntas las contesta el paciente sobre sí mismo. No hace falta
        completarlas todas de una: se guarda lo que haya y se sigue en la próxima
        consulta. El día que exista el formulario online, son exactamente estas
        preguntas las que se publican.
      </p>
      <div id="formHistoria"></div>
      <div class="toolbar acciones">
        <span id="avisoCambios" style="font-size:.82rem; color:var(--warn); margin-right:auto"></span>
        <button class="btn btn-primary" id="guardarHistoria">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M5 12l5 5L20 7" /></svg
          >
          Guardar historia clínica
        </button>
      </div>
    </div>

    <!-- ══════════ EVALUACIONES ══════════ -->
    <div class="tabpane hidden" data-pane="evaluaciones">
      <div id="listaEvaluaciones"></div>
      <div id="editorEvaluacion" class="apilado hidden"></div>
    </div>

    <!-- ══════════ FOTOS ══════════ -->
    <div class="tabpane hidden" data-pane="fotos">
      <div class="section-title">
        Fotos clínicas
        <span class="hint">misma luz, misma distancia y mismo peinado en cada control</span>
      </div>
      <p class="section-desc">
        Elegí en qué momento del tratamiento estás y desde dónde sacaste la foto;
        después subí las imágenes. El sistema las ordena solas para comparar la
        evolución.
      </p>

      <div class="toolbar">
        <div class="field" style="min-width:180px">
          <label for="momentoSubida">Momento</label>
          <select id="momentoSubida"></select>
        </div>
        <div class="field" style="min-width:180px">
          <label for="tomaSubida">Toma</label>
          <select id="tomaSubida"></select>
        </div>
        <div class="field" style="min-width:150px">
          <label for="fechaSubida">Fecha</label>
          <input type="date" id="fechaSubida" />
        </div>
      </div>

      <div class="dropzone" id="zonaFotos" tabindex="0" role="button">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
          ><path d="M12 16V4M8 8l4-4 4 4" /><path
            d="M4 15v3.5A1.5 1.5 0 0 0 5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V15"
          /></svg
        >
        <b>Sacar o subir fotos</b>
        <small>
          Tocá acá para elegir del equipo o sacar una con la cámara. También podés
          arrastrar las imágenes hasta este recuadro.
        </small>
        <input type="file" id="archivoFotos" accept="image/*" multiple hidden />
      </div>
      <div id="progresoSubida" style="margin-top:10px; font-size:.85rem; color:var(--muted)"></div>

      <div id="galeria"></div>
    </div>

    <!-- ══════════ MARCADO ══════════ -->
    <div class="tabpane hidden" data-pane="marcado">
      <div class="section-title">
        Diseño de la línea de implante
        <span class="hint">se dibuja arriba de la foto — la foto original no se toca</span>
      </div>
      <p class="section-desc">
        Elegí una foto del paciente y marcá encima la nueva línea frontal y las
        zonas a implantar. Sirve para mostrárselo en la pantalla del consultorio y
        queda guardado para comparar contra el resultado.
      </p>

      <div id="tiraFotos"></div>
      <div id="areaMarcado"></div>
    </div>

    <!-- ══════════ CUENTA ══════════ -->
    <div class="tabpane hidden" data-pane="cuenta">
      <div class="section-title">
        Cuenta del paciente
        <a class="hint" id="registrarPago" href="#">Registrar un cobro →</a>
      </div>
      <p class="section-desc">
        Todo lo que este paciente pagó, tomado de Finanzas. Sirve para saber de un
        vistazo cuánto lleva abonado del tratamiento.
      </p>
      <div id="cajaCuenta"></div>
    </div>

    <!-- ══════════ BLOQUEO PARA RECEPCIÓN ══════════ -->
    <div class="tabpane hidden" data-pane="bloqueado">
      <div class="lock">
        <div class="ring">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            ><rect x="4.5" y="10" width="15" height="10" rx="2" /><path
              d="M8 10V7a4 4 0 0 1 8 0v3"
            /></svg
          >
        </div>
        <h3>Sección reservada al médico</h3>
        <p>
          La historia clínica y las fotos de los pacientes solo las ve el
          profesional. Desde recepción se gestionan los datos de contacto y los
          turnos.
        </p>
      </div>
    </div>
  </section>
</AppLayout>

<script>
  import { pb } from "../../lib/pocketbase";
  import { puedeVerClinico, puedeEliminarPacientes, usuarioActual } from "../../lib/auth";
  import { imagen, liberar, achicarFoto } from "../../lib/archivos";
  import { Marcador, COLORES_MARCADO } from "../../lib/marcador";
  import {
    SECCIONES_HISTORIA,
    SECCIONES_EVALUACION,
    seccionesPara,
    alertas,
    progresoSeccion,
  } from "../../lib/cuestionario";
  import {
    dibujarSeccion,
    activarFormulario,
    leerFormulario,
    combinarRespuestas,
    actualizarProgresos,
  } from "../../lib/formulario";
  import {
    esc, fecha, fechaInput, hoyInput, edad, iniciales, colorDe, legible, enlace,
    aviso, mensajeDeError, montoARS, ESTADOS_PACIENTE, TOMAS, MOMENTOS,
    ORDEN_MOMENTOS, TIPOS_EVALUACION, COMO_LLEGO, CATEGORIAS, MEDIOS_PAGO, ICONO,
  } from "../../lib/ui";

  const idPaciente = new URLSearchParams(location.search).get("id");
  const clinico = puedeVerClinico();

  let paciente: any = null;
  let historia: any = null;
  let fotos: any[] = [];
  let seccionesDelPaciente = SECCIONES_HISTORIA;

  if (!idPaciente) location.href = "/pacientes/";

  /* ══════════════════ Pestañas ══════════════════ */

  /** Cambia de pestaña sin disparar la carga de datos (para cuando quien llama
   *  se encarga de cargar y necesita esperar a que termine). */
  function mostrarPestañaSinCargar(nombre: string) {
    document.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) =>
      p.classList.toggle("hidden", p.dataset.pane !== nombre)
    );
    document.querySelectorAll<HTMLElement>("#pestanas button").forEach((b) =>
      b.classList.toggle("active", b.dataset.tab === nombre)
    );
  }

  function mostrarPestaña(nombre: string) {
    mostrarPestañaSinCargar(nombre);
    if (nombre === "fotos") cargarGaleria();
    if (nombre === "marcado") cargarTiraFotos();
    if (nombre === "evaluaciones") cargarEvaluaciones();
    if (nombre === "cuenta") cargarCuenta();
  }

  document.querySelectorAll<HTMLElement>("#pestanas button").forEach((b) => {
    b.addEventListener("click", () => mostrarPestaña(b.dataset.tab!));
  });

  if (!clinico) {
    // Recepción: se quitan las pestañas clínicas y los bloques marcados.
    document.querySelectorAll('[data-solo="clinico"]').forEach((el) => el.remove());
  }

  /* ══════════════════ Cabecera y resumen ══════════════════ */

  async function cargarPaciente() {
    try {
      paciente = await pb.collection("pacientes").getOne(idPaciente!, { expand: "medico" });
    } catch {
      aviso("No se encontró el paciente.", "error");
      return;
    }

    const años = edad(paciente.fecha_nacimiento);
    document.getElementById("pfNombre")!.textContent = `${paciente.apellido}, ${paciente.nombre}`;
    const avatar = document.getElementById("pfAvatar")!;
    avatar.textContent = iniciales(paciente.apellido, paciente.nombre);
    avatar.style.background = colorDe(paciente.id);
    (document.getElementById("botonEditar") as HTMLAnchorElement).href =
      enlace("/pacientes/nuevo", { id: paciente.id });
    (document.getElementById("botonTurno") as HTMLAnchorElement).href =
      enlace("/agenda", { paciente: paciente.id });
    const enlacePago = document.getElementById("registrarPago") as HTMLAnchorElement | null;
    if (enlacePago) enlacePago.href = enlace("/finanzas", { paciente: paciente.id });

    const estado = ESTADOS_PACIENTE[paciente.estado ?? ""] ?? { texto: "Sin estado", tono: "neutral" };
    document.getElementById("pfMeta")!.innerHTML = [
      años !== null ? `<span><b>${años}</b> años</span>` : "",
      paciente.sexo ? `<span>${esc(legible(paciente.sexo))}</span>` : "",
      paciente.dni ? `<span>DNI <b>${esc(paciente.dni)}</b></span>` : "",
      paciente.telefono ? `<span>Tel <b>${esc(paciente.telefono)}</b></span>` : "",
      `<span class="pill ${estado.tono}">${esc(estado.texto)}</span>`,
    ].filter(Boolean).join("");

    // Solo se muestran las secciones que corresponden al sexo cargado.
    seccionesDelPaciente = seccionesPara(SECCIONES_HISTORIA, paciente.sexo);

    // Las alergias van arriba de todo, junto a las banderas rojas: es lo que
    // hay que ver sí o sí antes de un procedimiento.
    if (paciente.alergias) {
      document.getElementById("pfMeta")!.insertAdjacentHTML(
        "beforeend",
        `<span class="pill bad" title="Alergias">Alergias: ${esc(paciente.alergias)}</span>`
      );
    }

    const medico = paciente.expand?.medico?.nombre;
    document.getElementById("dlPersonales")!.innerHTML = [
      ["Alergias", paciente.alergias],
      ["Fecha de nacimiento", fecha(paciente.fecha_nacimiento)],
      ["Teléfono", paciente.telefono],
      ["Email", paciente.email],
      ["Domicilio", [paciente.domicilio, paciente.localidad].filter(Boolean).join(" · ")],
      ["Profesión / actividad", paciente.ocupacion],
      ["Primera consulta", fecha(paciente.fecha_primera_consulta)],
      ["Médico evaluador", medico],
      ["Cómo llegó", [COMO_LLEGO[paciente.como_llego] ?? "", paciente.como_llego_detalle].filter(Boolean).join(" · ")],
      ["Observaciones", paciente.observaciones],
    ]
      .filter(([, v]) => v)
      .map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`)
      .join("") || `<div><dt>Sin datos adicionales</dt><dd>Tocá “Editar datos” para completarlos.</dd></div>`;

    if (clinico) {
      await cargarHistoria();
      await cargarUltimaEvaluacion();
    }
  }

  /* ══════════════════ Eliminar el paciente ══════════════════ */

  /**
   * Borrado definitivo de un paciente. Quién puede: la misma regla que aplica
   * el servidor (ver `puedeEliminarPacientes`); acá solo se esconde el botón.
   *
   * Qué se lleva puesto, y por qué cada cosa:
   *   · historia, evaluaciones, fotos y marcados → los borra PocketBase solo,
   *     por el `cascadeDelete: true` de las migraciones. No hay que tocarlos.
   *   · turnos → los borramos nosotros. Están con `cascadeDelete: false`, así
   *     que si no, quedan en la agenda apuntando a alguien que ya no existe.
   *   · movimientos de dinero → NO se borran. Un cobro hecho es un hecho
   *     contable: si desapareciera, los totales de Finanzas dejarían de cerrar.
   *     Se les saca la relación y se les anota a nombre de quién estaban.
   *
   * Pide escribir el apellido a propósito: un `confirm()` se acepta de memoria
   * sin leerlo, y acá lo que se pierde es una historia clínica entera.
   */
  async function abrirEliminarPaciente() {
    if (!paciente) return;

    const filtro = `paciente = "${paciente.id}"`;
    const nombre = `${paciente.apellido}, ${paciente.nombre}`;

    let hi = 0, ev = 0, ft = 0, tu = 0, mo = 0;
    try {
      const [rHi, rEv, rFt, rTu, rMo] = await Promise.all([
        pb.collection("historias").getList(1, 1, { filter: filtro }),
        pb.collection("evaluaciones").getList(1, 1, { filter: filtro }),
        pb.collection("fotos").getList(1, 1, { filter: filtro }),
        pb.collection("turnos").getList(1, 1, { filter: filtro }),
        pb.collection("movimientos").getList(1, 1, { filter: filtro }),
      ]);
      hi = rHi.totalItems; ev = rEv.totalItems; ft = rFt.totalItems;
      tu = rTu.totalItems; mo = rMo.totalItems;
    } catch (e) {
      aviso(mensajeDeError(e), "error");
      return;
    }

    const plural = (n: number, uno: string, varios: string) =>
      `${n} ${n === 1 ? uno : varios}`;
    const seBorra = [
      hi ? "la historia clínica completa" : "",
      ev ? plural(ev, "evaluación", "evaluaciones") : "",
      ft ? `${plural(ft, "foto", "fotos")} (y los marcados hechos encima)` : "",
      tu ? `${plural(tu, "turno", "turnos")} de la agenda` : "",
    ].filter(Boolean);

    const dlg = document.createElement("dialog");
    dlg.className = "modal";
    dlg.innerHTML = `
      <div class="modal-head">
        <h3>Eliminar a ${esc(nombre)}</h3>
        <button class="modal-cerrar" aria-label="Cerrar">&times;</button>
      </div>
      <div class="modal-body">
        <p><b>Esto no se puede deshacer.</b> Se borra para siempre:</p>
        <ul style="margin:var(--esp-2) 0 0 1.2em">
          ${
            seBorra.length
              ? seBorra.map((t) => `<li>${esc(t)}</li>`).join("")
              : "<li>solo la ficha: todavía no tiene nada cargado</li>"
          }
        </ul>
        ${
          mo === 1
            ? `<p style="margin-top:var(--esp-3)">El <b>movimiento de dinero</b> no se borra: queda en Finanzas anotado a nombre de “${esc(nombre)}”, para que las cuentas sigan cerrando.</p>`
            : mo > 1
              ? `<p style="margin-top:var(--esp-3)">Los <b>${mo} movimientos de dinero</b> no se borran: quedan en Finanzas anotados a nombre de “${esc(nombre)}”, para que las cuentas sigan cerrando.</p>`
              : ""
        }
        <p style="margin-top:var(--esp-3)">Si lo único que querés es sacarlo del listado, cerrá esto y en “Editar datos” ponele el estado <b>Inactivo</b>: así no se pierde nada y podés volver atrás.</p>
        <div class="field" style="margin-top:var(--esp-3)">
          <label>Para confirmar, escribí el apellido: <b>${esc(paciente.apellido)}</b></label>
          <input type="text" id="confirmaApellido" autocomplete="off" spellcheck="false">
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn btn-ghost btn-sm" id="cancelarEliminar">Cancelar</button>
        <button class="btn btn-danger btn-sm" id="confirmarEliminar" disabled>${ICONO.borrar} Eliminar definitivamente</button>
      </div>`;
    document.body.appendChild(dlg);
    dlg.showModal();

    const cerrar = () => {
      dlg.close();
      dlg.remove();
    };
    dlg.querySelector(".modal-cerrar")?.addEventListener("click", cerrar);
    dlg.querySelector("#cancelarEliminar")?.addEventListener("click", cerrar);

    const campo = dlg.querySelector("#confirmaApellido") as HTMLInputElement;
    const botonOk = dlg.querySelector("#confirmarEliminar") as HTMLButtonElement;
    // Se acepta con o sin tilde y en mayúsculas o minúsculas: "Rios" vale
    // para "Ríos". Lo que importa es que se lea el nombre, no la ortografía.
    const normalizar = (t: string) =>
      t.normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim().toLocaleLowerCase();
    const coincide = () =>
      normalizar(campo.value) === normalizar(String(paciente.apellido));
    campo.addEventListener("input", () => {
      botonOk.disabled = !coincide();
    });
    campo.focus();

    botonOk.addEventListener("click", async () => {
      if (!coincide()) return;
      botonOk.disabled = true;
      botonOk.textContent = "Eliminando…";
      try {
        // 1. Los cobros se conservan, con el nombre anotado.
        const movs = await pb.collection("movimientos").getFullList({ filter: filtro });
        for (const m of movs) {
          const nota = `Paciente eliminado: ${nombre}`;
          await pb.collection("movimientos").update(m.id, {
            paciente: null,
            notas: (m.notas ? `${m.notas}\n${nota}` : nota).slice(0, 2000),
          });
        }
        // 2. Los turnos no tienen sentido sin el paciente.
        const turnos = await pb.collection("turnos").getFullList({ filter: filtro });
        for (const t of turnos) await pb.collection("turnos").delete(t.id);
        // 3. Y la ficha. Historia, evaluaciones, fotos y marcados caen con ella.
        await pb.collection("pacientes").delete(paciente.id);
        location.href = "/pacientes/";
      } catch (e) {
        aviso(mensajeDeError(e), "error");
        botonOk.innerHTML = `${ICONO.borrar} Eliminar definitivamente`;
        botonOk.disabled = false;
      }
    });
  }

  // Se esconde con la clase `.hidden` y no con el atributo `hidden`: el
  // `display` de `.btn` le gana al atributo y el botón quedaba a la vista de
  // recepción (el servidor igual le rechazaba el borrado).
  if (puedeEliminarPacientes()) {
    const b = document.getElementById("botonEliminar") as HTMLButtonElement;
    b.classList.remove("hidden");
    b.addEventListener("click", abrirEliminarPaciente);
  }

  /* ══════════════════ Historia clínica ══════════════════ */

  async function cargarHistoria() {
    try {
      historia = await pb
        .collection("historias")
        .getFirstListItem(pb.filter("paciente = {:p}", { p: idPaciente }));
    } catch {
      historia = null; // todavía no tiene historia: se crea al guardar
    }
    dibujarHistoria();
    dibujarAlertas();
  }

  function dibujarHistoria() {
    const respuestas = historia?.respuestas ?? {};
    const caja = document.getElementById("formHistoria");
    if (!caja) return;

    caja.innerHTML = seccionesDelPaciente
      .map((s) => dibujarSeccion(s, respuestas, { abierta: false }))
      .join("");

    activarFormulario(caja, () => {
      actualizarProgresos(caja, seccionesDelPaciente);
      document.getElementById("avisoCambios")!.textContent = "Hay cambios sin guardar";
      refrescarProgresoTotal();
    });
    refrescarProgresoTotal();
  }

  function refrescarProgresoTotal() {
    const caja = document.getElementById("formHistoria");
    if (!caja) return;
    const respuestas = leerFormulario(caja);
    let hechas = 0, total = 0;
    for (const s of seccionesDelPaciente) {
      const p = progresoSeccion(s, respuestas);
      hechas += p.contestadas;
      total += p.total;
    }
    document.getElementById("progresoTotal")!.textContent = `${hechas} de ${total} preguntas contestadas`;
  }

  function dibujarAlertas() {
    const caja = document.getElementById("cajaAlertas");
    if (!caja) return;
    const banderas = alertas(historia?.respuestas ?? {});
    caja.innerHTML = banderas.length
      ? `<div class="alertas">
           <h4>${ICONO.alerta} Puntos a tener en cuenta</h4>
           <ul>${banderas.map((a) => `<li>${esc(a)}</li>`).join("")}</ul>
         </div>`
      : "";
  }

  document.getElementById("guardarHistoria")?.addEventListener("click", async () => {
    const boton = document.getElementById("guardarHistoria") as HTMLButtonElement;
    const caja = document.getElementById("formHistoria")!;
    boton.disabled = true;
    try {
      const datos = {
        paciente: idPaciente,
        // Se combina con lo guardado para no borrar las secciones que hoy no
        // se muestran (ver combinarRespuestas).
        respuestas: combinarRespuestas(historia?.respuestas, leerFormulario(caja), caja),
        completado_por: historia?.completado_por ?? "medico",
        estado: historia?.estado ?? "borrador",
        actualizado_por: usuarioActual()?.id ?? null,
      };
      historia = historia
        ? await pb.collection("historias").update(historia.id, datos)
        : await pb.collection("historias").create(datos);
      document.getElementById("avisoCambios")!.textContent = "";
      dibujarAlertas();
      aviso("Historia clínica guardada.");
    } catch (e) {
      aviso(mensajeDeError(e), "error");
    }
    boton.disabled = false;
  });

