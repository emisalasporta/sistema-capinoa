      <div id="formEvaluacion"></div>

      <div class="card pad">
        <div class="section-title">Impresión diagnóstica / conclusión médica</div>
        <div class="field">
          <textarea id="evImpresion" style="min-height:150px" placeholder="Diagnóstico principal · diferenciales · grado de alopecia · estado de la zona donante · pronóstico · tratamiento recomendado · estudios · necesidad de FUE · objetivos realistas · próximo control">${esc(ev?.impresion ?? "")}</textarea>
        </div>
